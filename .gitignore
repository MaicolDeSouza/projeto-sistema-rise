# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Skills instaladas por `prisma init` — tres copias identicas, uma por
# ferramenta de IA. Reinstalaveis a partir de skills-lock.json, que fica
# versionado. Manter .claude/launch.json.
/.agents/
/.windsurf/
/.claude/skills/

# Certificados de HTTPS local (mkcert) - regeraveis, nunca versionar chave privada
/certificates/

# Imagens enviadas pelo sistema. Ficam fora do build (public/ nao sobrevive a
# deploy com Docker) e viram volume no VPS.
/dados/

# Mockups do companion visual do brainstorming (skill superpowers): material de
# conversa, nao do sistema.
/.superpowers/
