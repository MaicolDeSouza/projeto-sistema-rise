// Sistema Rise — schema do banco
// Prisma 7: a URL do banco vem de prisma.config.ts, nao daqui.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Canal {
  BLING
  MERCADO_LIVRE
  LOJA_INTEGRADA
  SHOPEE
}

/// Tipo de producao que a NF-e nativa da Loja Integrada usa (production_type).
enum TipoProducao {
  REVENDA
  FABRICACAO_PROPRIA
}

/// Produto simples ou com composicao (kit: feito de outros produtos do Rise, em quantidades).
/// Pedido do dono em 07/10/2026; ate ali o kit so existia dentro do anuncio do Mercado Livre.
enum TipoProduto {
  SIMPLES
  COMPOSICAO
}

enum Servico {
  BLING
  MERCADO_LIVRE
  LOJA_INTEGRADA
  /// Geracao de titulo e descricao por IA no cadastro de produto.
  ANTHROPIC
  /// Consulta publica de CEP no cadastro de cliente. So o CEP sai daqui.
  VIACEP
  /// Tratamento da foto do produto novo (Photoroom). Cada previa (sandbox, gratis) e
  /// cada compra (producao, cobra) e uma linha; o modo vai no `endpoint`.
  PHOTOROOM
  /// Foto do produto refeita pelo Nano Banana (modelos de imagem do Google, API Gemini). Cada geracao paga
  /// e uma linha; o modelo vai no `endpoint`. Nunca grava a chave, a imagem nem o prompt.
  GEMINI
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum Sexo {
  MASCULINO
  FEMININO
}

/// GERAL e o endereco do cliente; ENTREGA so existe quando e DIFERENTE dele —
/// igual ao Geral, nao se grava linha (ver ClienteEndereco).
enum TipoEndereco {
  GERAL
  ENTREGA
}

/// Codigo de regime tributario (CRT) da NF-e. Nulo no cliente = "Nao definido".
enum RegimeTributario {
  SIMPLES_NACIONAL
  SIMPLES_EXCESSO_SUBLIMITE
  REGIME_NORMAL
}

/// Estado INTERNO do anuncio no Sistema Rise — o quanto ele avancou no nosso
/// fluxo. Nao confundir com SituacaoCanal, que e o estado la fora.
enum StatusAnuncio {
  RASCUNHO
  VALIDADO
  PUBLICANDO
  PUBLICADO
  ERRO
}

/// Estado do anuncio DENTRO do canal. Separado do status interno porque os dois
/// divergem: o Mercado Livre pausa anuncios sozinho por falta de estoque, e sem
/// essa distincao a tela continuaria dizendo "publicado, tudo certo".
enum SituacaoCanal {
  ATIVA
  PAUSADA
  ENCERRADA
  DESCONHECIDA
}

enum StatusJob {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHOU
  CANCELADO
}

enum TipoArquivo {
  IMAGEM
  /// Manual, datasheet, ficha tecnica: um tipo so desde 16/09/2026. Na pratica o
  /// mesmo PDF traz especificacao e instrucao de uso, e dois campos viravam uma
  /// escolha a cada cadastro.
  DOCUMENTO
  CERTIFICADO
}

/// Papel de uma imagem do produto. FOTO aparece no carrossel e nos anuncios; RESERVA fica guardada
/// (original e versoes geradas que o dono nao escolheu) e so aparece atras do botao "Reserva".
enum PapelArquivo {
  FOTO
  RESERVA
}

enum StatusConexao {
  NAO_CONFIGURADO
  CONECTADO
  EXPIRADO
  ERRO
}

// ---------------------------------------------------------------------------
// Catalogo
// ---------------------------------------------------------------------------

/// Dados do produto neutros de canal. O anuncio de cada canal deriva daqui.
model Produto {
  id            String  @id @default(cuid())
  sku           String  @unique
  ean           String?
  marca         String?
  modelo        String?
  tituloBase    String
  descricaoBase String?

  custo      Decimal? @db.Decimal(12, 2)
  precoVenda Decimal? @db.Decimal(12, 2)
  estoque    Int      @default(0)

  /// Onde a peca fica fisicamente no estoque (ex.: R14). Nao vai para canal
  /// nenhum — existe para a separacao do pedido ser rapida.
  localizacao String?

  pesoKg        Decimal? @db.Decimal(10, 3)
  alturaCm      Decimal? @db.Decimal(10, 2)
  larguraCm     Decimal? @db.Decimal(10, 2)
  comprimentoCm Decimal? @db.Decimal(10, 2)
  garantiaMeses Int?

  /// Unidade de medida. Lista fechada porque o Bling valida esse valor ao
  /// cadastrar o produto — com texto livre o mesmo item viraria "un", "UN" e
  /// "unidade", e a publicacao falharia sem motivo aparente.
  unidade String? @default("UN")

  /// Numero da homologacao Anatel/INMETRO. O certificado em si e um arquivo do
  /// tipo CERTIFICADO; o numero fica aqui porque e ele que o Mercado Livre pede.
  numeroHomologacao String?

  /// Link do video do produto (YouTube). O Mercado Livre aceita video no anuncio.
  videoUrl String?

  /// Pagina do produto na Loja Integrada. Preenchido a mao: as URLs da LI sao
  /// baseadas no NOME do produto e editaveis item a item, entao nao ha como
  /// deduzi-las a partir do id que o Bling devolve.
  urlLojaIntegrada String?

  /// Estoque desejado da loja (nao do fornecedor): o item tem um saldo so.
  estoqueMinimo Int?
  estoqueMaximo Int?

  // --- Fiscais ---
  // So os campos que IDENTIFICAM o produto e viajam com ele. Os valores
  // calculados de imposto continuam no Bling, que emite a nota e tem as regras
  // tributarias — duplica-los aqui criaria uma segunda fonte de verdade fiscal.
  /// Origem da mercadoria, 0 a 8 (tabela da NF-e).
  origem             Int?
  /// Tipo de producao da NF-e da Loja Integrada; muda o CFOP. Revenda e o caso da loja.
  tipoProducao       TipoProducao @default(REVENDA)
  ncm                String?
  cest               String?
  /// Tipo do item na tabela 4.3.1 do SPED PIS/COFINS.
  spedTipoItem       String?
  /// Percentual aproximado de tributos (Lei da Transparencia).
  percentualTributos Decimal? @db.Decimal(5, 2)

  /// ID do produto no Bling, preenchido quando o produto e espelhado no ERP.
  blingId String?

  // --- Sincronizacao com o Bling (plano de 04/10/2026) ---
  /// Quando o produto foi enviado ao Bling pela ultima vez. Nulo = nunca
  /// sincronizado (icone cinza); preenchido = ja sincronizado (icone verde).
  blingSincronizadoEm DateTime?
  /// Resumo dos campos enviados no ULTIMO envio. A tela compara com o resumo de
  /// hoje para saber se o Rise mudou depois, sem reler o Bling. Nulo = nunca enviado.
  blingAssinatura     String?
  /// Saldo de estoque lido do Bling (o saldoVirtualTotal) na ultima vez que o
  /// operador usou o botao da lista. Pode ser NEGATIVO: o saldo virtual desconta
  /// reservas. Nulo = nunca lido. O estoque do Rise e este saldo mais os ajustes
  /// pendentes (MovimentoEstoque.enviadoAoBlingEm nulo).
  blingSaldo          Int?

  ativo   Boolean @default(true)

  /// SIMPLES ou COMPOSICAO (kit). No kit, `estoque` e GRAVADO ja calculado pelas pecas (o menor de
  /// estoque da peca / quantidade), e nao editado: as telas, a foto mensal e a sincronizacao leem a
  /// coluna como sempre leram.
  tipo TipoProduto @default(SIMPLES)

  /// Marca "produto totalmente conferido" (pedido do dono em 22/09/2026): antes
  /// vivia so no navegador (ConferidoProduto.jsx) e sumia ao recarregar. Agora
  /// grava de verdade, para a contagem "(N verificados)" da lista ser real.
  conferido Boolean @default(false)

  /// Fornecedor extraido do Bling na importacao, {nome, descricao, codigo,
  /// precoCusto} — combinado de DUAS chamadas (ver lerFornecedorBling em
  /// importarBling.js): o nome vem de GET /produtos/{id} (fornecedor.contato.
  /// nome) e descricao/codigo/precoCusto de GET /produtos/fornecedores. SO
  /// RASCUNHO, nunca cria Fornecedor/ProdutoFornecedor sozinho (pedido do dono
  /// em 22/09/2026: "esses campos devem ser apenas rascunhos"). A aba
  /// Fornecedores/Concorrentes mostra esta linha como editavel; salvarProduto a
  /// confirma em vinculo de verdade e zera este campo.
  fornecedorRascunho Json?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  arquivos     ProdutoArquivo[]
  fornecedores ProdutoFornecedor[]
  concorrentes ProdutoConcorrente[]
  anuncios     Anuncio[]

  movimentosEstoque MovimentoEstoque[]
  blingCopias       BlingCopiaProduto[]
  copiasDeCanal     CopiaProdutoCanal[]

  /// As pecas deste kit, e os kits em que este produto e peca.
  componentes ProdutoComponente[] @relation("KitPecas")
  usadoEm     ProdutoComponente[] @relation("PecaKits")

  @@index([marca])
  @@index([ativo])
}

/// Uma peca de um produto com composicao (kit): qual produto e quantas unidades.
model ProdutoComponente {
  id    String  @id @default(cuid())
  kitId String
  kit   Produto @relation("KitPecas", fields: [kitId], references: [id], onDelete: Cascade)

  componenteId String
  /// Restrict de proposito: apagar uma peca que ainda esta em kit deixaria o kit sem o que
  /// vende. A acao de excluir confere antes e diz em quais kits a peca esta.
  componente Produto @relation("PecaKits", fields: [componenteId], references: [id], onDelete: Restrict)

  quantidade Int
  /// Ordem das linhas na aba Composicao (a do Bling, quando importado).
  ordem Int @default(0)

  criadoEm DateTime @default(now())

  @@unique([kitId, componenteId])
  @@index([componenteId])
}

enum TipoMovimentoEstoque {
  /// Soma ao saldo.
  ENTRADA
  /// Tira do saldo (nunca deixa negativo).
  SAIDA
  /// Define o saldo: o operador contou e informa quantas pecas ha de verdade.
  BALANCO
}

/// Historico do ajuste de estoque feito na lista de Produtos (pedido do dono em
/// 30/09/2026): entrada, saida e balanco. Cada linha guarda o saldo ANTES e DEPOIS,
/// para o balanco (que so informa o total contado) mostrar a diferenca e para o
/// historico se ler sem refazer a conta.
///
/// SO NESTE SISTEMA: nada e enviado ao Bling nem aos canais (a escrita esta
/// desligada, e o Mercado Livre e a Loja Integrada leem o saldo pelo Bling). Quando
/// ela for ligada, estas linhas sao o que ha para enviar.
///
/// Apagar o produto apaga o historico dele — a exclusao ja e explicita, e o popup
/// lista nome e SKU de cada um antes.
model MovimentoEstoque {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  tipo TipoMovimentoEstoque
  /// ENTRADA e SAIDA: quantas pecas se moveram. BALANCO: o total contado.
  quantidade    Int
  saldoAnterior Int
  saldoNovo     Int

  motivo     String?
  observacao String?

  /// Quando este ajuste foi aplicado ao saldo do Bling. NULO = PENDENTE: o ajuste
  /// existe so aqui e o Bling ainda nao sabe dele (a sincronizacao envia os
  /// pendentes na ordem e marca cada um depois que o Bling aceita). Os movimentos
  /// que ja existiam quando esta coluna nasceu foram marcados pela migration, para
  /// nao reenviar o passado.
  enviadoAoBlingEm DateTime?

  criadoEm DateTime @default(now())

  @@index([produtoId, criadoEm])
}

/// Copia de seguranca do produto no Bling, tirada ANTES de cada envio mas gravada
/// so DEPOIS de o Bling aceitar (envio que falha nao deixa copia). Guarda o produto
/// como o Bling o tinha (`conteudo`) e o resumo "campo: de -> para" do que o envio
/// mudou (`alteracoes`), para desfazer a mao se preciso. Ficam as 3 mais recentes
/// por produto; as mais velhas sao apagadas pelo codigo de envio.
///
/// Apagar o produto apaga as copias dele (Cascade): sem produto no Rise elas nao
/// tem a quem servir.
model BlingCopiaProduto {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  /// O produto como estava no Bling antes do envio (resposta do GET).
  conteudo   Json
  /// O que o envio mudou: lista de {campo, de, para}. Nulo = sem resumo.
  alteracoes Json?

  @@index([produtoId, criadoEm])
}

/// O produto do canal como estava antes de cada sobrescrita. O PUT da Loja Integrada
/// exige o produto inteiro, e um campo esquecido no corpo apagaria dado de la: a copia
/// e o que permite desfazer a mao.
model CopiaProdutoCanal {
  id        String  @id @default(cuid())
  canal     Canal
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  /// O produto como estava no canal antes do envio (resposta do GET).
  conteudo   Json
  /// O que o envio mudou: lista de {campo, de, para}. Nulo = sem resumo.
  alteracoes Json?

  @@index([produtoId, canal, criadoEm])
}

/// Arquivos do produto: imagens, documentos tecnicos e certificado.
///
/// Uma tabela para todos os tipos, e nao uma por tipo: envio, validacao,
/// exibicao e exclusao sao identicos, entao um tipo novo passa a ser um valor
/// de enum em vez de uma tabela nova.
///
/// O ENDERECO NAO E GRAVADO. Os arquivos moram em dados/produtos/<SKU>/<tipo>/,
/// e o SKU pode mudar — uma URL gravada ficaria velha na primeira renomeacao.
/// O endereco e calculado na leitura, a partir do SKU atual do produto.
model ProdutoArquivo {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  tipo    TipoArquivo @default(IMAGEM)
  arquivo String

  /// Nome que veio do usuario. Serve so para exibir — o arquivo em disco usa
  /// nome gerado pelo sistema.
  nomeOriginal String?
  mimeType     String?
  tamanhoBytes Int?

  /// Imagem principal do produto.
  ///
  /// E uma MARCA, nao a posicao 0: se fosse posicao, escolher a principal
  /// obrigaria a reordenar todas as outras — o que fazia as miniaturas
  /// dancarem na tela e custava uma transacao no banco a cada clique.
  principal Boolean @default(false)

  /// SEM USO. Nasceu em 04/10/2026 para guardar o check verde ("validada") das fotos, e no mesmo dia o dono
  /// decidiu que SO as fotos validadas sao salvas: toda foto gravada ja e validada, entao nao ha o que
  /// guardar (o painel a devolve sempre validada ao reabrir). Nada le nem escreve esta coluna. Fica aqui
  /// so para nao mexer no schema com outra frente ativa; remover na proxima migration de quem o alterar.
  finalizada Boolean @default(false)

  ordem Int @default(0)

  /// So faz sentido para imagem. TODA leitura de foto do produto filtra `papel: "FOTO"`: a reserva nao
  /// conta nas 100 fotos, nao vai para anuncio, nao e foto principal.
  papel PapelArquivo @default(FOTO)

  /// Rotulo da versao desta imagem: "original", "photoroom" ou "nanobanana". E so rotulo (a tela e o
  /// Salvar o usam para dizer o que cada arquivo e); nenhuma regra de seguranca depende dele.
  versao String @default("original")

  /// Liga o original e as versoes geradas da MESMA foto (FOTO e RESERVA com o mesmo grupo). Linhas
  /// anteriores a esta coluna ganham grupo = id na migration; nulo vale "o proprio id".
  grupo String?

  criadoEm DateTime @default(now())

  @@index([produtoId, tipo, ordem])
  @@index([produtoId, grupo])
}

/// Prompt salvo por modelo do Nano Banana. `modelo` e a chave do `MODELOS` no codigo (nano-banana-2...),
/// NAO o id do Google. Sem linha vale o `PROMPT_PADRAO` do codigo; salvar o texto igual ao padrao apaga a linha.
model PromptImagem {
  modelo       String   @id
  texto        String
  atualizadoEm DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Anuncios
// ---------------------------------------------------------------------------

/// Guarda o conteudo gerado e o resultado da publicacao num canal, de forma
/// independente dos outros.
///
/// O ML e a Shopee aceitam VARIOS anuncios do mesmo produto (Classico e Premium,
/// por exemplo), entao o par (produto, canal) nao e unico. O Bling e a Loja
/// Integrada continuam com UM so: quem garante isso e o indice unico parcial
/// `Anuncio_um_por_produto` (migration 20261001_canais_de_venda_ml), que mora so no
/// SQL porque o Prisma nao descreve indice parcial — como o `Job_fonte_aberta`.
///
/// `dados` guarda o que e proprio do canal e nao tem coluna: no ML, o rascunho do
/// anuncio (tipo Classico/Premium, condicao, etapa, vinculo com o Bling e composicao
/// do kit). O formato e do codigo do canal; o banco so guarda o JSON.
model Anuncio {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  canal         Canal
  status        StatusAnuncio @default(RASCUNHO)
  situacaoCanal SituacaoCanal @default(DESCONHECIDA)

  /// Anuncio com venda tem campos travados pelo canal (no ML, o titulo).
  temVendas Boolean @default(false)

  titulo    String?
  descricao String?
  /// Atributos/ficha tecnica no formato exigido pelo canal.
  atributos Json?

  /// Rascunho e escolhas proprias do canal (ver o comentario do modelo).
  dados Json?

  categoriaExternaId String?
  /// ID do anuncio no canal (ex.: MLB1234567890).
  idExterno          String?
  urlExterna         String?

  /// O que foi enviado na ultima publicacao. Depurar uma rejeicao sem isso e
  /// adivinhacao.
  payloadEnviado Json?

  /// Hash do conteudo no momento da publicacao. Se o Produto mudar depois, a
  /// tela avisa "alteracoes nao publicadas" em vez de fingir que esta em dia.
  hashConteudo String?

  erro           String?
  publicadoEm    DateTime?
  sincronizadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  logs LogIntegracao[]

  // Indice comum: a unicidade do Bling e da Loja Integrada e parcial e vive no SQL.
  @@index([produtoId, canal])
  @@index([status])
  @@index([canal, status])
}

/// Configuracao de um canal de venda que vale para todos os anuncios dele.
/// Uma linha por canal (a chave e o proprio canal).
model ConfigCanal {
  canal Canal @id

  /// Frases fixas que o dono quer em toda descricao do canal (ex.: "Todos os
  /// nossos produtos possuem nota fiscal").
  frasesFixas String[] @default([])

  atualizadoEm DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Integracoes
// ---------------------------------------------------------------------------

/// Credenciais de cada servico externo.
///
/// `segredoCifrado` guarda UM JSON cifrado (AES-256-GCM) com tudo que e
/// sigiloso daquele servico — cada conector conhece a forma do proprio JSON.
/// Isso acomoda modelos de autenticacao diferentes (OAuth do Bling e do
/// Mercado Livre, as duas chaves estaticas da Loja Integrada, e futuramente o
/// partner_id/shop_id da Shopee) sem mudar o schema a cada canal novo.
///
/// Os demais campos sao metadados NAO sigilosos: existem para a tela mostrar
/// situacao e expiracao sem precisar decifrar credencial nenhuma.
model Conexao {
  id      String  @id @default(cuid())
  servico Servico @unique

  segredoCifrado String?

  status       StatusConexao @default(NAO_CONFIGURADO)
  contaExterna String?
  escopos      String?
  expiraEm     DateTime?
  conectadoEm  DateTime?

  ultimoTesteEm DateTime?
  ultimoTesteOk Boolean?
  ultimoErro    String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Fornecedores
// ---------------------------------------------------------------------------

/// Cadastro de fornecedores, reaproveitado entre produtos.
///
/// Os dados da EMPRESA (contato, prazo, condicoes) moram aqui; a FONTE de coleta
/// (`FonteColeta`) e so o site que o worker varre. Sao coisas diferentes — ha
/// fornecedor sem site e ha site sem negociacao nenhuma — por isso a ligacao e
/// opcional (`fonteId`) e nenhum lado depende do outro para existir.
model Fornecedor {
  id   String @id @default(cuid())
  nome String @unique

  cnpj               String?
  /// Fornecedor de fora do Brasil: nao tem CNPJ. Sem esta marca o CNPJ e
  /// obrigatorio no cadastro (pedido do dono em 04/10/2026). Fornecedor criado
  /// pela fonte de Mercados nasce sem CNPJ e sem esta marca; o formulario exige
  /// um dos dois na proxima vez que for salvo.
  estrangeiro        Boolean  @default(false)
  site               String?
  contato            String?
  telefone           String?
  email              String?
  prazoEntregaDias   Int?
  condicoesPagamento String?
  pedidoMinimo       Decimal? @db.Decimal(12, 2)
  observacoes        String?
  ativo              Boolean  @default(true)

  /// SetNull: excluir a fonte nao pode levar junto o contato e a negociacao.
  fonteId String?
  fonte   FonteColeta? @relation(fields: [fonteId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  produtos ProdutoFornecedor[]

  @@index([fonteId])
}

/// Cadastro de concorrentes (empresa). Antes so existia como `FonteColeta`
/// tipo CONCORRENTE e como texto solto em `ProdutoConcorrente.fonteManual`.
model Concorrente {
  id   String @id @default(cuid())
  nome String @unique

  site        String?
  telefone    String?
  email       String?
  observacoes String?
  ativo       Boolean @default(true)

  /// SetNull, pelo mesmo motivo do Fornecedor.
  fonteId String?
  fonte   FonteColeta? @relation(fields: [fonteId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([fonteId])
}

/// Cliente final, pessoa fisica ou juridica. NAO se mistura com Fornecedor
/// (pedido do dono em 18/09/2026): o Bling junta os dois numa tela so, aqui sao
/// cadastros separados.
///
/// Os campos de um tipo ficam nulos no outro: o servidor zera o que nao pertence
/// ao tipo escolhido, para trocar Fisica por Juridica na tela e voltar atras nao
/// deixar lixo gravado.
model Cliente {
  id   String @id @default(cuid())
  nome String

  tipoPessoa TipoPessoa @default(FISICA)
  /// CPF ou CNPJ, guardado formatado. Nulo permitido (varios nulos nao colidem no
  /// Postgres); quando preenchido, e unico.
  documento  String?    @unique

  clienteDesde DateTime @default(now()) @db.Date

  // So pessoa fisica.
  sexo        Sexo?
  naturalidade String?

  // So pessoa juridica.
  nomeFantasia       String?
  regimeTributario   RegimeTributario?
  inscricaoEstadual  String?
  /// Com a IE isenta marcada, a inscricao estadual fica vazia.
  ieIsento           Boolean @default(false)
  inscricaoMunicipal String?

  /// O primeiro telefone/e-mail fica em `telefone`/`email` e os demais nas listas:
  /// e o que o resto do sistema ja le, e a coluna antiga segue valendo para quem
  /// ainda nao conhece as listas.
  telefone            String?
  telefonesAdicionais String[] @default([])
  email               String?
  emailsAdicionais    String[] @default([])
  observacoes         String?
  ativo               Boolean  @default(true)

  /// Restrict: apagar uma transportadora que ainda e preferida por cliente
  /// esconderia a preferencia sem ninguem ver. A acao conta e avisa.
  transportadoraId String?
  transportadora   Transportadora? @relation(fields: [transportadoraId], references: [id], onDelete: Restrict)

  /// As opcoes que o cliente prefere (varias).
  condicoesPreferidas CondicaoPagamento[]

  enderecos ClienteEndereco[]
  contatos  ClienteContato[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([transportadoraId])
}

/// Endereco do cliente. Uma linha GERAL e, SO se a entrega for em outro lugar,
/// uma ENTREGA. Cliente cuja entrega e no mesmo endereco NAO ganha linha de
/// entrega: gravar uma copia deixaria o endereco de entrega velho quando o Geral
/// mudasse.
model ClienteEndereco {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipo TipoEndereco

  cep         String?
  uf          String?
  cidade      String?
  bairro      String?
  logradouro  String?
  numero      String?
  complemento String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([clienteId, tipo])
}

/// Pessoas do cliente (comprador, financeiro), com telefone e e-mail proprios.
/// Sao gravadas TODAS juntas: a tela manda a lista inteira e o servidor a troca.
model ClienteContato {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome     String
  cargo    String?
  telefone String?
  email    String?

  criadoEm DateTime @default(now())

  @@index([clienteId])
}

/// Como a transportadora leva a encomenda. Serve para filtrar e, depois, para
/// diferenciar regras de frete.
enum ModalidadeTransporte {
  CORREIOS
  RODOVIARIA
  ENTREGA_LOCAL
  OUTRA
}

/// Transportadoras, de onde o cliente escolhe a preferida.
model Transportadora {
  id   String @id @default(cuid())
  /// Razao social; o nome pelo qual e conhecida fica em `nomeFantasia`.
  nome String @unique

  nomeFantasia String?
  cnpj         String?
  /// Dado do transportador que a NF-e pede.
  inscricaoEstadual String?
  ieIsento          Boolean @default(false)

  modalidade ModalidadeTransporte?
  /// Endereco de consulta com `{codigo}` no lugar do codigo de rastreio; o bloco
  /// Pedidos monta o link do cliente com ele.
  urlRastreamento String?
  site            String?

  // Endereco (um so; o cliente e que tem Geral e Entrega).
  cep         String?
  uf          String?
  cidade      String?
  bairro      String?
  logradouro  String?
  numero      String?
  complemento String?

  /// O primeiro telefone/e-mail fica em `telefone`/`email` e os demais nas listas,
  /// como no cliente.
  telefone            String?
  telefonesAdicionais String[] @default([])
  email               String?
  emailsAdicionais    String[] @default([])

  observacoes String?
  ativo       Boolean @default(true)

  /// SEM USO desde 19/09/2026: o contato agora e a lista `contatos` e o prazo saiu do
  /// cadastro. Ficam na tabela de proposito — a outra frente usa o mesmo banco com o
  /// client antigo, e apagar a coluna quebraria o salvar dela. Apagar depois que
  /// as duas frentes estiverem no mesmo schema.
  contato          String?
  prazoEntregaDias Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clientes Cliente[]
  contatos TransportadoraContato[]
}

/// Pessoas da transportadora (atendimento, financeiro), com telefone e e-mail
/// proprios. Gravadas TODAS juntas: a tela manda a lista inteira e o servidor a troca.
model TransportadoraContato {
  id               String         @id @default(cuid())
  transportadoraId String
  transportadora   Transportadora @relation(fields: [transportadoraId], references: [id], onDelete: Cascade)

  nome     String
  cargo    String?
  telefone String?
  email    String?

  criadoEm DateTime @default(now())

  @@index([transportadoraId])
}

/// Condicoes de pagamento ("A vista", "28 dias", "30/60/90"), de onde o cliente
/// escolhe as que prefere.
model CondicaoPagamento {
  id   String @id @default(cuid())
  nome String @unique

  observacoes String?
  ativo       Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clientes Cliente[]
}

/// Marcas dos produtos. Hoje `Produto.marca` e texto solto; este cadastro evita
/// "Elgin"/"ELGIN"/"Elgin " como tres marcas. Sempre em MAIUSCULAS, como o
/// campo Marca do produto (pedido do dono em 16/09/2026).
model Marca {
  id   String @id @default(cuid())
  nome String @unique

  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Vinculo produto x fornecedor: o mesmo item pode vir de varios fornecedores,
/// cada um com o proprio codigo, preco e link.
model ProdutoFornecedor {
  id           String     @id @default(cuid())
  produtoId    String
  produto      Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedorId String
  /// Restrict de proposito: apagar um fornecedor que ainda abastece produtos
  /// levaria junto o historico de custo deles.
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)

  descricao  String?
  codigo     String?
  precoCusto Decimal? @db.Decimal(12, 2)
  /// Pagina do produto NO SITE do fornecedor.
  link       String?
  /// De qual fornecedor sai o custo do produto. Exatamente um por produto.
  padrao     Boolean  @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([produtoId, fornecedorId])
  @@index([fornecedorId])
}

/// Concorrente vinculado ao produto para comparar preco na tela de cadastro
/// (pedido do dono em 18/09/2026) — marcado na lupa do Nome ou digitado a mao.
///
/// QUANDO VEM DA LUPA (`produtoColetadoId` preenchido), NAO guarda copia do
/// preco: a tela le fonte/nome/codigo/preco de HOJE em `ProdutoColetado` toda
/// vez que abre o produto, para acompanhar a proxima varredura sem o operador
/// precisar remover e adicionar de novo — decisao do dono em 18/09/2026, ao
/// contrario do preco de custo do Fornecedor, que e o que o operador negociou
/// e faz sentido ficar fixo.
///
/// QUANDO E DIGITADO A MAO (`produtoColetadoId` nulo, sem produto coletado por
/// tras), os campos `*Manual` guardam o que foi escrito, fixo — nao ha
/// varredura para seguir.
model ProdutoConcorrente {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  /// SetNull e nao Restrict: o Mercados nunca apaga produto coletado (fica
  /// "ausente"), mas se um dia apagar, o vinculo cai para manual em vez de
  /// travar a exclusao la.
  produtoColetadoId String?
  produtoColetado   ProdutoColetado? @relation(fields: [produtoColetadoId], references: [id], onDelete: SetNull)

  fonteManual  String?
  nomeManual   String?
  codigoManual String?
  precoManual  Decimal? @db.Decimal(12, 2)
  linkManual   String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([produtoId, produtoColetadoId])
  @@index([produtoColetadoId])
}

/// Fila de trabalho processada pelo worker (publicacao, sincronizacao).
model Job {
  id      String    @id @default(cuid())
  tipo    String
  payload Json
  status  StatusJob @default(PENDENTE)

  tentativas         Int      @default(0)
  maxTentativas      Int      @default(3)
  proximaTentativaEm DateTime @default(now())
  erro               String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// Fonte da coleta, em coluna: um indice unico PARCIAL (so em PENDENTE e
  /// PROCESSANDO, na migration 20260916_worker_paralelo) garante um job aberto
  /// por fonte. O Prisma nao descreve indice parcial — ele mora so no SQL.
  fonteId    String?
  /// Worker dono do job em andamento (WorkerColeta.id). So o dono escreve nele.
  workerId   String?
  /// Sinal de vida do job, escrito POR RELOGIO pelo dono, e nao pelo andamento:
  /// job sem sinal ha mais de JOB_SEM_SINAL_MS foi largado (src/lib/coleta/fila.js).
  sinalEm    DateTime?
  iniciadoEm DateTime?

  @@index([status, proximaTentativaEm])
  @@index([status, sinalEm])
}

/// Worker da coleta no ar. Um so por vez (trava consultiva no Postgres); a tela
/// le daqui se ha quem atenda a fila.
model WorkerColeta {
  id          String    @id
  pid         Int
  maquina     String
  /// Quantas varreduras ele faz ao mesmo tempo (COLETA_PARALELO).
  paralelo    Int
  iniciadoEm  DateTime  @default(now())
  sinalEm     DateTime  @default(now())
  encerradoEm DateTime?
}

/// Auditoria de toda chamada a API externa. E o que torna possivel depurar
/// uma rejeicao do Mercado Livre depois que ela aconteceu.
model LogIntegracao {
  id      String  @id @default(cuid())
  servico Servico

  /// Vincula a chamada ao anuncio que a originou, dando uma linha do tempo por
  /// anuncio de graca.
  anuncioId String?
  anuncio   Anuncio? @relation(fields: [anuncioId], references: [id], onDelete: SetNull)

  metodo     String
  endpoint   String
  statusHttp Int?
  duracaoMs  Int?

  requestResumo  String?
  responseResumo String?
  erro           String?

  criadoEm DateTime @default(now())

  @@index([servico, criadoEm])
  @@index([anuncioId])
}

// ---------------------------------------------------------------------------
// Mercados — dados coletados de concorrentes e fornecedores
// ---------------------------------------------------------------------------
//
// Este conjunto NAO se liga ao catalogo proprio. Nenhuma das tabelas abaixo tem
// referencia a Produto: a secao Mercados existe para olhar o que os outros
// vendem, e uma chave estrangeira sem uso seria divida disfarcada de precaucao.

enum TipoFonte {
  CONCORRENTE
  FORNECEDOR
  OUTRO
}

/// Um site sendo acompanhado.
///
/// Fica em tabela, e nao em lista no codigo como src/lib/canais.js, porque o
/// dono acrescenta loja pela tela — sem deploy.
model FonteColeta {
  id      String    @id @default(cuid())
  nome    String
  dominio String
  tipo    TipoFonte

  /// Limita a varredura a um trecho do site (ex.: "/informatica/"). O
  /// concorrente pode vender de tudo, e varrer o supermercado inteiro para
  /// achar eletronicos gasta uma hora por nada.
  prefixoUrl String?

  urlSitemap String?

  /// Falso quando o robots.txt do site nos barra. A fonte continua cadastrada e
  /// visivel com o motivo, mas nunca e varrida — bloqueio se respeita, nao se
  /// dribla.
  robotsPermite Boolean @default(true)

  /// O que o cadastro conseguiu extrair da pagina de amostra. Guardado para a
  /// tela poder dizer "extracao OK (titulo, preco, marca)" sem refazer o teste.
  amostraResumo String?

  /// Quantos produtos o SITE declara ter, contados no sitemap. E o denominador
  /// da tela: sem ele, saber que coletamos 2732 paginas nao diz se falta muito.
  produtosNoSite Int?

  /// Verdadeiro quando a contagem parou no teto de leitura — o catalogo e MAIOR
  /// que o numero guardado, e a tela precisa dizer isso em vez de mentir um total.
  produtosNoSiteParcial Boolean @default(false)
  /// Anotacao livre do operador sobre esta fonte: onde baixar a lista, com que
  /// login, qual aba da planilha exportar. E conhecimento que hoje mora na
  /// cabeca de quem faz — a Fortek exige entrar no portal e salvar a pagina, a
  /// Santana so mostra preco a cliente cadastrado — e some quando outra pessoa
  /// assume a tarefa.
  ///
  /// SEM SENHA AQUI. O campo e texto simples e aparece na tela; credencial vai
  /// para a tabela Conexao, que e cifrada.
  instrucoes String?

  ativa          Boolean @default(true)
  /// 30 dias (720 h), decidido pelo dono em 16/09/2026. Era 24 h, mas com o
  /// catalogo inteiro de cada loja uma varredura leva horas (o Eletrogate, 8.783
  /// paginas a 10 s cada) e emendava na seguinte.
  intervaloHoras Int     @default(720)

  /// Sem agendamento automatico; a coleta so comeca pelo botao Atualizar dados.
  proximaVarreduraEm DateTime?
  ultimaVarreduraEm  DateTime?

  /// A ULTIMA COLETA GRAVADA, escrita por quem grava — worker, linha de comando
  /// ou carga. `ultimaVarreduraEm` so o worker escreve, e reprocessar a lista
  /// Esta fonte e varrida pelo worker do PC do dono, e NAO pelo da VPS: o site bloqueia o IP de datacenter da VPS
  /// (e outros virao). O worker normal ignora a fonte marcada; o `npm run worker:pc` pega SO as marcadas e grava no
  /// banco da VPS por um tunel SSH. Desligar a marca devolve a fonte ao worker da VPS.
  varridaNoPc Boolean @default(false)

  /// fora dele deixava a fonte "nunca varrida" com 1.911 produtos guardados.
  ultimaColetaEm        DateTime?
  /// "site" ou "arquivo". E o que deixa a trava de queda comparar lista com
  /// lista: a colheita do site traz 20 produtos, e comparar com os 1.900 da
  /// lista acusaria queda em toda troca de caminho.
  ultimaColetaOrigem    String?
  ultimaColetaTotal     Int?
  /// Quanto a coleta demorou. Separa "o site e lento" de "o site pede 10s entre
  /// visitas" — o Eletrogate leva quatro vezes a Smartkits pelo mesmo trabalho.
  ultimaColetaDuracaoMs Int?
  ultimaColetaResumo    String?

  /// Quando o FORNECEDOR mandou a lista — nao quando ela foi reprocessada. Sem
  /// isto, lista de tres semanas parece tao fresca quanto vitrine varrida agora.
  listaEnviadaEm DateTime?
  /// Os arquivos do ultimo envio, [{nome, bytes}]. Os ORIGINAIS ficam em
  /// dados/coleta/<dominio>/arquivos/: sao eles que se reprocessam quando um
  /// leitor melhora, sem pedir a lista de novo ao fornecedor.
  listaArquivos  Json?

  /// PORTAL COM LOGIN, varrido por categoria (a Santana, 17/09/2026). O dono nao
  /// trabalha com o catalogo inteiro do fornecedor: informa os links das
  /// categorias que interessam, e so elas sao varridas. [{url, total, adicionadaEm}].
  categorias Json?

  /// Usuario e senha do portal, CIFRADOS juntos ({usuario, senha}, AES-256-GCM de
  /// lib/crypto.js). Moram na fonte, e nao em Conexao, porque Conexao tem uma
  /// linha por SERVICO (enum unico) e o login e de cada fornecedor. A tela nunca
  /// recebe o valor: so sabe que existe e quando mudou.
  credencialCifrada     String?
  credencialAtualizadaEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  produtos ProdutoColetado[]

  /// Cadastro da empresa por tras desta fonte (Cadastros). Nasce junto com a
  /// fonte em `salvarFonte`; um fornecedor OU um concorrente, conforme o tipo.
  fornecedores Fornecedor[]
  concorrentes Concorrente[]

  @@unique([dominio, prefixoUrl])
  @@index([ativa, proximaVarreduraEm])
}

/// Um produto de uma das fontes, lido do site ou da lista do fornecedor.
///
/// Espelha o produto que `normalizar.js` e os leitores de arquivo devolvem —
/// uma forma so, venha de onde vier. Substituiu a PaginaColetada, que era do
/// extrator antigo e exigia URL: os 1.911 produtos da Fortek vem de lista de
/// portal atras de login e nao tem endereco nenhum.
///
/// ATUALIZADO NO LUGAR, nunca duplicado. O preco tem serie propria; aqui fica a
/// versao corrente.
model ProdutoColetado {
  id      String      @id @default(cuid())
  fonteId String
  fonte   FonteColeta @relation(fields: [fonteId], references: [id], onDelete: Cascade)

  /// O que identifica o produto DENTRO da fonte: o codigo da loja, que e o
  /// ponto de acesso ao produto do concorrente; sem codigo, o endereco; sem
  /// os dois, o nome. Nunca a posicao na lista — uma coleta nova embaralharia.
  chave  String
  /// "site" ou "arquivo". Produto de lista nao tem pagina publica, e a tela
  /// diz isso em vez de montar link que nao leva a lugar nenhum.
  origem String

  codigo    String?
  nome      String?
  marca     String?
  modelo    String?
  mpn       String?
  ean       String?
  categoria String?
  ncm       String?
  url       String?

  precoNormal      Decimal? @db.Decimal(12, 2)
  precoPromocional Decimal? @db.Decimal(12, 2)
  /// O preco do que ainda vai chegar. Na Fortek a reserva chega a custar MAIS
  /// que a pronta entrega (65-276: 82,90 contra 79,90), e num campo so a
  /// inversao sumiria.
  precoReserva     Decimal? @db.Decimal(12, 2)
  precoComImpostos Decimal? @db.Decimal(12, 2)
  /// [{nome, percentual}] — quais impostos entraram no preco com impostos.
  impostos         Json?

  /// Como a loja declarou: AVAILABLE, IN_STOCK, OUT_OF_STOCK... ou nada.
  estoqueStatus String?
  /// PRECO POR QUANTIDADE ("compra em lote"): [{rotulo, minimo, maximo, preco}].
  /// Pedido do dono em 17/09/2026: faixa de preco e multiplo de venda sao regra de
  /// COMPRA, nao caracteristica do produto, e tem caixa propria na tela.
  precosPorQuantidade Json?
  /// Vende-se de N em N (a Santana vende o motor 075-3010 de 5 em 5).
  multiploVenda       Int?

  /// Pronta entrega. NUNCA somada ao que esta a chegar.
  quantidade    Int?
  aChegar       Int?

  /// O saldo que estava aqui ANTES da ultima mudanca, e quando ele foi visto.
  ///
  /// E a base do historico de venda que o dono vai montar: com os dois numeros e
  /// as duas datas da para dizer quanto saiu entre uma varredura e outra. So
  /// muda quando a quantidade muda; saldo nao informado (produto fora da lista
  /// do fornecedor) nao apaga o que estava guardado.
  quantidadeAnterior   Int?
  quantidadeAnteriorEm DateTime?

  /// A primeira foto, em coluna propria: a lista de cem linhas le so ela, e
  /// trazer a galeria inteira — na Fortek, fotos em base64 — seria carga que
  /// ninguem ve.
  miniatura      String?
  imagens        Json?
  descricao      String?
  /// LISTA ORDENADA de {nome, valor}: a ficha tem linha sem rotulo, que objeto
  /// nenhum comporta sem inventar chave.
  especificacoes Json?
  documentos     Json?
  variantes      Json?
  seo            Json?
  plataforma     Json?
  /// De onde veio cada valor — o que separa dado lido de dado calculado.
  origens        Json?

  /// Produto que saiu da lista do fornecedor FICA, com o saldo a null. Ausente
  /// nao e zero: "esgotou" e afirmacao dele, "nao veio" e observacao nossa.
  ausenteDesde  DateTime?
  ausenteMotivo String?

  /// Nome, marca, modelo e codigos, sem acento e minusculo, na ESCRITA. A
  /// descricao fica de fora: procurar "preto" devolveria o catalogo inteiro.
  buscaTexto   String?
  /// Assinatura do conteudo: coleta sem mudanca so avanca o `vistoEm`, sem
  /// reescrever a linha.
  hashConteudo String?

  /// Quando a pagina foi lida (ou a lista processada) na coleta que gravou.
  coletadoEm DateTime?
  /// A ultima coleta em que o produto apareceu. Produto de site que nao veio
  /// numa amostra de 20 nao some: so fica com esta data mais antiga.
  vistoEm    DateTime @default(now())

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  precos PrecoHistorico[]
  /// Produtos que marcaram este como concorrente, para comparar preco.
  concorrenteDe ProdutoConcorrente[]

  @@unique([fonteId, chave])
  @@index([fonteId, vistoEm])
}

/// Serie de preco por produto.
///
/// So ganha linha QUANDO PRECO OU ESTOQUE DECLARADO MUDAM. Uma linha por coleta
/// engordaria a tabela com a lista inteira da Fortek a cada reprocessamento,
/// sem dizer nada de novo. A quantidade fica de fora de proposito: muda todo
/// dia no fornecedor e faria toda coleta parecer mudanca de preco.
model PrecoHistorico {
  id        String          @id @default(cuid())
  produtoId String
  produto   ProdutoColetado @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  precoNormal      Decimal? @db.Decimal(12, 2)
  precoPromocional Decimal? @db.Decimal(12, 2)
  precoReserva     Decimal? @db.Decimal(12, 2)
  estoqueStatus    String?

  coletadoEm DateTime @default(now())

  @@index([produtoId, coletadoEm])
}

/// Qual preco a foto mensal guardou. O mesmo campo `preco` recebe valores de
/// natureza diferente conforme a fonte, e sem dizer qual foi, a serie do mes
/// seguinte misturaria "com IPI" e "sem IPI" sem ninguem perceber.
enum TipoPrecoFoto {
  /// Preco de tabela (a regra do sistema: nunca o promocional quando ha o normal).
  NORMAL
  /// Fornecedor: o que se paga de fato, com os impostos que ele cobra por fora.
  COM_IMPOSTOS
  /// So quando a loja nao publicou o normal (`normal ?? promocional`).
  PROMOCIONAL
}

/// FOTO MENSAL de fornecedor e concorrente: uma linha por produto por mes, com
/// preco e estoque como estavam no banco no dia 14 (pedido do dono em 30/09/2026,
/// para guardar 12 meses de historico). Tirada por `fotos.js`.
///
/// Difere de `PrecoHistorico`, que so ganha linha quando o preco MUDA: aqui ha uma
/// linha por mes mesmo sem mudanca, e o estoque entra. E o que separa "nao mudou"
/// de "nao foi coletado".
///
/// SEM RELACAO com ProdutoColetado, de proposito: com `onDelete: Cascade`, apagar
/// uma fonte levaria o historico dela junto. Por isso a foto copia fonte, codigo e
/// nome — sobrevive a fonte e produto apagados.
model FotoMensalColeta {
  id        String   @id @default(cuid())
  /// ProdutoColetado.id, sem chave estrangeira (ver acima).
  produtoId String
  /// Primeiro dia do mes da foto. A do dia 14 de setembro e "2026-09-01".
  mes       DateTime @db.Date

  fonteId   String
  fonteNome String
  tipoFonte TipoFonte
  codigo    String?
  nome      String?

  preco     Decimal?       @db.Decimal(12, 2)
  tipoPreco TipoPrecoFoto?

  /// Pronta entrega e o que esta a chegar, nunca somados. Nulo = a fonte nao
  /// informa (a maioria dos concorrentes so diz "disponivel"). NUNCA 0 no lugar de
  /// "nao informado": esgotado e afirmacao da loja, "nao veio" e observacao nossa.
  quantidade    Int?
  aChegar       Int?
  estoqueStatus String?
  /// Fornecedor: o produto saiu da lista dele e ficou sem saldo confirmado.
  ausente       Boolean @default(false)

  /// Quando o dado foi LIDO — nao quando a foto foi tirada. A foto do dia 14 traz
  /// dados da varredura anterior, e lista de fornecedor que ninguem reenviou traz
  /// a data antiga: e essa data que diz o quanto o numero esta velho.
  lidoEm   DateTime?
  tiradaEm DateTime  @default(now())

  @@unique([produtoId, mes])
  @@index([mes, fonteId])
}

/// FOTO MENSAL dos produtos da loja (`Produto`): preco de venda, custo e estoque
/// como estavam no banco no dia da foto. Sem relacao com `Produto`, pelo mesmo
/// motivo da coleta: excluir um produto da lista nao apaga o que ele foi.
///
/// O ESTOQUE E O DA IMPORTACAO DO BLING, nao o do dia: nada aqui o atualiza depois
/// (o sistema nao escreve no Bling nem le o saldo a cada foto — decisao do dono em
/// 30/09/2026, "fotografar o que esta no banco"). `produtoAtualizadoEm` guarda a
/// data da ultima mudanca do cadastro, para a foto dizer quao velho e o numero.
model FotoMensalProduto {
  id        String   @id @default(cuid())
  produtoId String
  mes       DateTime @db.Date

  sku    String
  titulo String
  ativo  Boolean

  precoVenda  Decimal? @db.Decimal(12, 2)
  /// Do fornecedor padrao, ou do rascunho vindo do Bling enquanto o vinculo nao foi
  /// confirmado, ou do proprio cadastro — nessa ordem. `custoOrigem` diz qual.
  custo       Decimal? @db.Decimal(12, 2)
  custoOrigem String?
  estoque     Int

  /// [{canal, status, situacaoCanal, idExterno}]: onde o produto tem anuncio. Nao ha
  /// PRECO POR CANAL no banco — os tres conectores leem `Produto.precoVenda` —, e
  /// so quando ele existir esta lista passa a carregar o preco de cada um.
  canais Json

  produtoAtualizadoEm DateTime
  tiradaEm            DateTime @default(now())

  @@unique([produtoId, mes])
  @@index([mes])
}
