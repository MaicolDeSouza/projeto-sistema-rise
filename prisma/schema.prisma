// Sistema Rise — schema do banco
// Prisma 7: a URL do banco vem de prisma.config.ts, nao daqui.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Canal {
  BLING
  MERCADO_LIVRE
  LOJA_INTEGRADA
  SHOPEE
}

enum Servico {
  BLING
  MERCADO_LIVRE
  LOJA_INTEGRADA
}

/// Estado INTERNO do anuncio no Sistema Rise — o quanto ele avancou no nosso
/// fluxo. Nao confundir com SituacaoCanal, que e o estado la fora.
enum StatusAnuncio {
  RASCUNHO
  VALIDADO
  PUBLICANDO
  PUBLICADO
  ERRO
}

/// Estado do anuncio DENTRO do canal. Separado do status interno porque os dois
/// divergem: o Mercado Livre pausa anuncios sozinho por falta de estoque, e sem
/// essa distincao a tela continuaria dizendo "publicado, tudo certo".
enum SituacaoCanal {
  ATIVA
  PAUSADA
  ENCERRADA
  DESCONHECIDA
}

enum StatusJob {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHOU
}

enum TipoArquivo {
  IMAGEM
  MANUAL
  FICHA_TECNICA
  CERTIFICADO
}

enum StatusConexao {
  NAO_CONFIGURADO
  CONECTADO
  EXPIRADO
  ERRO
}

// ---------------------------------------------------------------------------
// Catalogo
// ---------------------------------------------------------------------------

/// Dados do produto neutros de canal. O anuncio de cada canal deriva daqui.
model Produto {
  id            String  @id @default(cuid())
  sku           String  @unique
  ean           String?
  marca         String?
  modelo        String?
  tituloBase    String
  descricaoBase String?

  custo      Decimal? @db.Decimal(12, 2)
  precoVenda Decimal? @db.Decimal(12, 2)
  estoque    Int      @default(0)

  /// Onde a peca fica fisicamente no estoque (ex.: R14). Nao vai para canal
  /// nenhum — existe para a separacao do pedido ser rapida.
  localizacao String?

  pesoKg        Decimal? @db.Decimal(10, 3)
  alturaCm      Decimal? @db.Decimal(10, 2)
  larguraCm     Decimal? @db.Decimal(10, 2)
  comprimentoCm Decimal? @db.Decimal(10, 2)
  garantiaMeses Int?

  /// Unidade de medida. Lista fechada porque o Bling valida esse valor ao
  /// cadastrar o produto — com texto livre o mesmo item viraria "un", "UN" e
  /// "unidade", e a publicacao falharia sem motivo aparente.
  unidade String? @default("UN")

  /// Numero da homologacao Anatel/INMETRO. O certificado em si e um arquivo do
  /// tipo CERTIFICADO; o numero fica aqui porque e ele que o Mercado Livre pede.
  numeroHomologacao String?

  /// Link do video do produto (YouTube). O Mercado Livre aceita video no anuncio.
  videoUrl String?

  /// Pagina do produto na Loja Integrada. Preenchido a mao: as URLs da LI sao
  /// baseadas no NOME do produto e editaveis item a item, entao nao ha como
  /// deduzi-las a partir do id que o Bling devolve.
  urlLojaIntegrada String?

  /// Estoque desejado da loja (nao do fornecedor): o item tem um saldo so.
  estoqueMinimo Int?
  estoqueMaximo Int?

  // --- Fiscais ---
  // So os campos que IDENTIFICAM o produto e viajam com ele. Os valores
  // calculados de imposto continuam no Bling, que emite a nota e tem as regras
  // tributarias — duplica-los aqui criaria uma segunda fonte de verdade fiscal.
  /// Origem da mercadoria, 0 a 8 (tabela da NF-e).
  origem             Int?
  ncm                String?
  cest               String?
  /// Tipo do item na tabela 4.3.1 do SPED PIS/COFINS.
  spedTipoItem       String?
  /// Percentual aproximado de tributos (Lei da Transparencia).
  percentualTributos Decimal? @db.Decimal(5, 2)

  /// ID do produto no Bling, preenchido quando o produto e espelhado no ERP.
  blingId String?
  ativo   Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  arquivos     ProdutoArquivo[]
  fornecedores ProdutoFornecedor[]
  anuncios     Anuncio[]

  @@index([marca])
  @@index([ativo])
}

/// Arquivos do produto: imagens, manual, ficha tecnica e certificado.
///
/// Uma tabela para todos os tipos, e nao uma por tipo: envio, validacao,
/// exibicao e exclusao sao identicos, entao um tipo novo passa a ser um valor
/// de enum em vez de uma tabela nova.
///
/// O ENDERECO NAO E GRAVADO. Os arquivos moram em dados/produtos/<SKU>/<tipo>/,
/// e o SKU pode mudar — uma URL gravada ficaria velha na primeira renomeacao.
/// O endereco e calculado na leitura, a partir do SKU atual do produto.
model ProdutoArquivo {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  tipo    TipoArquivo @default(IMAGEM)
  arquivo String

  /// Nome que veio do usuario. Serve so para exibir — o arquivo em disco usa
  /// nome gerado pelo sistema.
  nomeOriginal String?
  mimeType     String?
  tamanhoBytes Int?

  /// Imagem principal do produto.
  ///
  /// E uma MARCA, nao a posicao 0: se fosse posicao, escolher a principal
  /// obrigaria a reordenar todas as outras — o que fazia as miniaturas
  /// dancarem na tela e custava uma transacao no banco a cada clique.
  principal Boolean @default(false)

  ordem Int @default(0)

  criadoEm DateTime @default(now())

  @@index([produtoId, tipo, ordem])
}

// ---------------------------------------------------------------------------
// Anuncios
// ---------------------------------------------------------------------------

/// Um anuncio por par (produto, canal). Guarda o conteudo gerado e o
/// resultado da publicacao naquele canal, de forma independente dos outros.
model Anuncio {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  canal         Canal
  status        StatusAnuncio @default(RASCUNHO)
  situacaoCanal SituacaoCanal @default(DESCONHECIDA)

  /// Anuncio com venda tem campos travados pelo canal (no ML, o titulo).
  temVendas Boolean @default(false)

  titulo    String?
  descricao String?
  /// Atributos/ficha tecnica no formato exigido pelo canal.
  atributos Json?

  categoriaExternaId String?
  /// ID do anuncio no canal (ex.: MLB1234567890).
  idExterno          String?
  urlExterna         String?

  /// O que foi enviado na ultima publicacao. Depurar uma rejeicao sem isso e
  /// adivinhacao.
  payloadEnviado Json?

  /// Hash do conteudo no momento da publicacao. Se o Produto mudar depois, a
  /// tela avisa "alteracoes nao publicadas" em vez de fingir que esta em dia.
  hashConteudo String?

  erro           String?
  publicadoEm    DateTime?
  sincronizadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  logs LogIntegracao[]

  @@unique([produtoId, canal])
  @@index([status])
  @@index([canal, status])
}

// ---------------------------------------------------------------------------
// Integracoes
// ---------------------------------------------------------------------------

/// Credenciais de cada servico externo.
///
/// `segredoCifrado` guarda UM JSON cifrado (AES-256-GCM) com tudo que e
/// sigiloso daquele servico — cada conector conhece a forma do proprio JSON.
/// Isso acomoda modelos de autenticacao diferentes (OAuth do Bling e do
/// Mercado Livre, as duas chaves estaticas da Loja Integrada, e futuramente o
/// partner_id/shop_id da Shopee) sem mudar o schema a cada canal novo.
///
/// Os demais campos sao metadados NAO sigilosos: existem para a tela mostrar
/// situacao e expiracao sem precisar decifrar credencial nenhuma.
model Conexao {
  id      String  @id @default(cuid())
  servico Servico @unique

  segredoCifrado String?

  status       StatusConexao @default(NAO_CONFIGURADO)
  contaExterna String?
  escopos      String?
  expiraEm     DateTime?
  conectadoEm  DateTime?

  ultimoTesteEm DateTime?
  ultimoTesteOk Boolean?
  ultimoErro    String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Fornecedores
// ---------------------------------------------------------------------------

/// Cadastro de fornecedores, reaproveitado entre produtos.
model Fornecedor {
  id   String @id @default(cuid())
  nome String @unique

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  produtos ProdutoFornecedor[]
}

/// Vinculo produto x fornecedor: o mesmo item pode vir de varios fornecedores,
/// cada um com o proprio codigo, preco e link.
model ProdutoFornecedor {
  id           String     @id @default(cuid())
  produtoId    String
  produto      Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedorId String
  /// Restrict de proposito: apagar um fornecedor que ainda abastece produtos
  /// levaria junto o historico de custo deles.
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)

  descricao  String?
  codigo     String?
  precoCusto Decimal? @db.Decimal(12, 2)
  /// Pagina do produto NO SITE do fornecedor.
  link       String?
  /// De qual fornecedor sai o custo do produto. Exatamente um por produto.
  padrao     Boolean  @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([produtoId, fornecedorId])
  @@index([fornecedorId])
}

/// Fila de trabalho processada pelo worker (publicacao, sincronizacao).
model Job {
  id      String    @id @default(cuid())
  tipo    String
  payload Json
  status  StatusJob @default(PENDENTE)

  tentativas         Int      @default(0)
  maxTentativas      Int      @default(3)
  proximaTentativaEm DateTime @default(now())
  erro               String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, proximaTentativaEm])
}

/// Auditoria de toda chamada a API externa. E o que torna possivel depurar
/// uma rejeicao do Mercado Livre depois que ela aconteceu.
model LogIntegracao {
  id      String  @id @default(cuid())
  servico Servico

  /// Vincula a chamada ao anuncio que a originou, dando uma linha do tempo por
  /// anuncio de graca.
  anuncioId String?
  anuncio   Anuncio? @relation(fields: [anuncioId], references: [id], onDelete: SetNull)

  metodo     String
  endpoint   String
  statusHttp Int?
  duracaoMs  Int?

  requestResumo  String?
  responseResumo String?
  erro           String?

  criadoEm DateTime @default(now())

  @@index([servico, criadoEm])
  @@index([anuncioId])
}

// ---------------------------------------------------------------------------
// Mercados — dados coletados de concorrentes e fornecedores
// ---------------------------------------------------------------------------
//
// Este conjunto NAO se liga ao catalogo proprio. Nenhuma das tabelas abaixo tem
// referencia a Produto: a secao Mercados existe para olhar o que os outros
// vendem, e uma chave estrangeira sem uso seria divida disfarcada de precaucao.

enum TipoFonte {
  CONCORRENTE
  FORNECEDOR
  OUTRO
}

/// Um site sendo acompanhado.
///
/// Fica em tabela, e nao em lista no codigo como src/lib/canais.js, porque o
/// dono acrescenta loja pela tela — sem deploy.
model FonteColeta {
  id      String    @id @default(cuid())
  nome    String
  dominio String
  tipo    TipoFonte

  /// Limita a varredura a um trecho do site (ex.: "/informatica/"). O
  /// concorrente pode vender de tudo, e varrer o supermercado inteiro para
  /// achar eletronicos gasta uma hora por nada.
  prefixoUrl String?

  urlSitemap String?

  /// Falso quando o robots.txt do site nos barra. A fonte continua cadastrada e
  /// visivel com o motivo, mas nunca e varrida — bloqueio se respeita, nao se
  /// dribla.
  robotsPermite Boolean @default(true)

  /// O que o cadastro conseguiu extrair da pagina de amostra. Guardado para a
  /// tela poder dizer "extracao OK (titulo, preco, marca)" sem refazer o teste.
  amostraResumo String?

  /// Quantos produtos o SITE declara ter, contados no sitemap. E o denominador
  /// da tela: sem ele, saber que coletamos 2732 paginas nao diz se falta muito.
  produtosNoSite Int?

  /// Verdadeiro quando a contagem parou no teto de leitura — o catalogo e MAIOR
  /// que o numero guardado, e a tela precisa dizer isso em vez de mentir um total.
  produtosNoSiteParcial Boolean @default(false)
  /// Anotacao livre do operador sobre esta fonte: onde baixar a lista, com que
  /// login, qual aba da planilha exportar. E conhecimento que hoje mora na
  /// cabeca de quem faz — a Fortek exige entrar no portal e salvar a pagina, a
  /// Santana so mostra preco a cliente cadastrado — e some quando outra pessoa
  /// assume a tarefa.
  ///
  /// SEM SENHA AQUI. O campo e texto simples e aparece na tela; credencial vai
  /// para a tabela Conexao, que e cifrada.
  instrucoes String?

  ativa          Boolean @default(true)
  intervaloHoras Int     @default(24)

  /// O relogio da varredura mora aqui, e nao num setInterval: o sistema roda na
  /// maquina do dono, que dorme e reinicia. Desligada dois dias, ela gera UMA
  /// varredura ao voltar em vez de tres acumuladas.
  proximaVarreduraEm DateTime @default(now())
  ultimaVarreduraEm  DateTime?

  /// A ULTIMA COLETA GRAVADA, escrita por quem grava — worker, linha de comando
  /// ou carga. `ultimaVarreduraEm` so o worker escreve, e reprocessar a lista
  /// fora dele deixava a fonte "nunca varrida" com 1.911 produtos guardados.
  ultimaColetaEm        DateTime?
  /// "site" ou "arquivo". E o que deixa a trava de queda comparar lista com
  /// lista: a colheita do site traz 20 produtos, e comparar com os 1.900 da
  /// lista acusaria queda em toda troca de caminho.
  ultimaColetaOrigem    String?
  ultimaColetaTotal     Int?
  /// Quanto a coleta demorou. Separa "o site e lento" de "o site pede 10s entre
  /// visitas" — o Eletrogate leva quatro vezes a Smartkits pelo mesmo trabalho.
  ultimaColetaDuracaoMs Int?
  ultimaColetaResumo    String?

  /// Quando o FORNECEDOR mandou a lista — nao quando ela foi reprocessada. Sem
  /// isto, lista de tres semanas parece tao fresca quanto vitrine varrida agora.
  listaEnviadaEm DateTime?
  /// Os arquivos do ultimo envio, [{nome, bytes}]. Os ORIGINAIS ficam em
  /// dados/coleta/<dominio>/arquivos/: sao eles que se reprocessam quando um
  /// leitor melhora, sem pedir a lista de novo ao fornecedor.
  listaArquivos  Json?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  produtos ProdutoColetado[]

  @@unique([dominio, prefixoUrl])
  @@index([ativa, proximaVarreduraEm])
}

/// Um produto de uma das fontes, lido do site ou da lista do fornecedor.
///
/// Espelha o produto que `normalizar.js` e os leitores de arquivo devolvem —
/// uma forma so, venha de onde vier. Substituiu a PaginaColetada, que era do
/// extrator antigo e exigia URL: os 1.911 produtos da Fortek vem de lista de
/// portal atras de login e nao tem endereco nenhum.
///
/// ATUALIZADO NO LUGAR, nunca duplicado. O preco tem serie propria; aqui fica a
/// versao corrente.
model ProdutoColetado {
  id      String      @id @default(cuid())
  fonteId String
  fonte   FonteColeta @relation(fields: [fonteId], references: [id], onDelete: Cascade)

  /// O que identifica o produto DENTRO da fonte: o codigo da loja, que e o
  /// ponto de acesso ao produto do concorrente; sem codigo, o endereco; sem
  /// os dois, o nome. Nunca a posicao na lista — uma coleta nova embaralharia.
  chave  String
  /// "site" ou "arquivo". Produto de lista nao tem pagina publica, e a tela
  /// diz isso em vez de montar link que nao leva a lugar nenhum.
  origem String

  codigo    String?
  nome      String?
  marca     String?
  modelo    String?
  mpn       String?
  ean       String?
  categoria String?
  ncm       String?
  url       String?

  precoNormal      Decimal? @db.Decimal(12, 2)
  precoPromocional Decimal? @db.Decimal(12, 2)
  /// O preco do que ainda vai chegar. Na Fortek a reserva chega a custar MAIS
  /// que a pronta entrega (65-276: 82,90 contra 79,90), e num campo so a
  /// inversao sumiria.
  precoReserva     Decimal? @db.Decimal(12, 2)
  precoComImpostos Decimal? @db.Decimal(12, 2)
  /// [{nome, percentual}] — quais impostos entraram no preco com impostos.
  impostos         Json?

  /// Como a loja declarou: AVAILABLE, IN_STOCK, OUT_OF_STOCK... ou nada.
  estoqueStatus String?
  /// Pronta entrega. NUNCA somada ao que esta a chegar.
  quantidade    Int?
  aChegar       Int?

  /// O saldo que estava aqui ANTES da ultima mudanca, e quando ele foi visto.
  ///
  /// E a base do historico de venda que o dono vai montar: com os dois numeros e
  /// as duas datas da para dizer quanto saiu entre uma varredura e outra. So
  /// muda quando a quantidade muda; saldo nao informado (produto fora da lista
  /// do fornecedor) nao apaga o que estava guardado.
  quantidadeAnterior   Int?
  quantidadeAnteriorEm DateTime?

  /// A primeira foto, em coluna propria: a lista de cem linhas le so ela, e
  /// trazer a galeria inteira — na Fortek, fotos em base64 — seria carga que
  /// ninguem ve.
  miniatura      String?
  imagens        Json?
  descricao      String?
  /// LISTA ORDENADA de {nome, valor}: a ficha tem linha sem rotulo, que objeto
  /// nenhum comporta sem inventar chave.
  especificacoes Json?
  documentos     Json?
  variantes      Json?
  seo            Json?
  plataforma     Json?
  /// De onde veio cada valor — o que separa dado lido de dado calculado.
  origens        Json?

  /// Produto que saiu da lista do fornecedor FICA, com o saldo a null. Ausente
  /// nao e zero: "esgotou" e afirmacao dele, "nao veio" e observacao nossa.
  ausenteDesde  DateTime?
  ausenteMotivo String?

  /// Nome, marca, modelo e codigos, sem acento e minusculo, na ESCRITA. A
  /// descricao fica de fora: procurar "preto" devolveria o catalogo inteiro.
  buscaTexto   String?
  /// Assinatura do conteudo: coleta sem mudanca so avanca o `vistoEm`, sem
  /// reescrever a linha.
  hashConteudo String?

  /// Quando a pagina foi lida (ou a lista processada) na coleta que gravou.
  coletadoEm DateTime?
  /// A ultima coleta em que o produto apareceu. Produto de site que nao veio
  /// numa amostra de 20 nao some: so fica com esta data mais antiga.
  vistoEm    DateTime @default(now())

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  precos PrecoHistorico[]

  @@unique([fonteId, chave])
  @@index([fonteId, vistoEm])
}

/// Serie de preco por produto.
///
/// So ganha linha QUANDO PRECO OU ESTOQUE DECLARADO MUDAM. Uma linha por coleta
/// engordaria a tabela com a lista inteira da Fortek a cada reprocessamento,
/// sem dizer nada de novo. A quantidade fica de fora de proposito: muda todo
/// dia no fornecedor e faria toda coleta parecer mudanca de preco.
model PrecoHistorico {
  id        String          @id @default(cuid())
  produtoId String
  produto   ProdutoColetado @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  precoNormal      Decimal? @db.Decimal(12, 2)
  precoPromocional Decimal? @db.Decimal(12, 2)
  precoReserva     Decimal? @db.Decimal(12, 2)
  estoqueStatus    String?

  coletadoEm DateTime @default(now())

  @@index([produtoId, coletadoEm])
}
