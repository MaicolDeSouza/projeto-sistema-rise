# Copie para .env e ajuste os valores.

# --- Container Postgres (lido pelo docker-compose.yml) ---
# Em VPS, gere uma senha forte: nunca suba a senha de desenvolvimento.
POSTGRES_USER=rise
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=sistema_rise
POSTGRES_PORT=5432

# --- Aplicacao ---
# Precisa bater com as variaveis acima.
# Em Postgres gerenciado (Neon, RDS, Supabase), acrescente ?sslmode=require
DATABASE_URL="postgresql://rise:troque_esta_senha@localhost:5432/sistema_rise?schema=public"

# --- Preenchidos no Bloco 1 (Criar Anuncios), ainda nao usados ---

# Chave de 32 bytes em hex para cifrar tokens em repouso.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENCAO: os tokens gravados em `Conexao` so sao legiveis com esta mesma chave.
# Ao migrar para VPS, leve a chave junto com o dump do banco — sem ela, todas as
# conexoes com Bling/Mercado Livre/Loja Integrada precisam ser refeitas.
# ENCRYPTION_KEY=

# ANTHROPIC_API_KEY=

# BLING_CLIENT_ID=
# BLING_CLIENT_SECRET=

# ML_CLIENT_ID=
# ML_CLIENT_SECRET=

# LI_CHAVE_API=
# LI_CHAVE_APLICACAO=
