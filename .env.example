# Copie para .env e preencha. O .env nunca vai para o git.

# --- Container Postgres (lido pelo docker-compose.yml) ---
# Em VPS, gere uma senha forte: nunca suba a senha de desenvolvimento.
POSTGRES_USER=rise
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=sistema_rise
POSTGRES_PORT=5432

# --- Banco (precisa bater com as variaveis acima) ---
# Em Postgres gerenciado (Neon, RDS, Supabase), acrescente ?sslmode=require
DATABASE_URL="postgresql://rise:troque_esta_senha@localhost:5432/sistema_rise?schema=public"

# --- Onde a interface roda ---
# Tem que ser localhost: o navegador bloqueia scripts servidos de dominios de
# loopback publico (localtest.me e afins), por causa de DNS rebinding.
APP_URL=https://localhost:3000

# Endereco publico do Rise (VPS). Vazio desliga o bloco de documentos na descricao
# da Loja Integrada: o cliente da loja nao alcanca o localhost.
APP_URL_PUBLICA=

# --- Cifra dos segredos gravados na tabela Conexao (AES-256-GCM) ---
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENCAO: os tokens em `Conexao` so sao legiveis com esta mesma chave. Ao
# migrar para outro servidor, leve a chave junto com o dump — sem ela, todas as
# conexoes precisam ser refeitas, e a falha se parece com erro de API.
ENCRYPTION_KEY=

# --- Bling (Cadastros > Aplicativos) ---
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=https://localhost:3000/api/oauth/bling/callback

# Canal de venda do Bling correspondente a conta do Mercado Livre.
# Ha varios canais tipo MercadoLivre e normalmente so um esta ativo; o id errado
# grava o anuncio no lugar errado e a sincronia de estoque falha SEM dar erro.
# Descubra com: npm run diagnostico (o teste do Bling lista os canais).
BLING_CANAL_ML_ID=

# --- Mercado Livre (developers.mercadolivre.com.br/devcenter) ---
# O ML RECUSA "localhost" no redirect. localtest.me e um dominio publico que
# resolve para 127.0.0.1: nada trafega pela internet, e dispensa tunel.
# Marque o escopo offline_access no aplicativo, senao nao vem refresh token.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://sistema-rise.localtest.me:3000/api/oauth/mercadolivre/callback

# --- Loja Integrada ---
# Integracao da propria loja: use o Personal Token, sem misturar com Chave API
# nem Chave de Aplicacao. Ele e enviado como `Authorization: Basic <token>`.
# O token tambem pode ser informado pela tela Integracoes; nesse caso fica
# cifrado no banco e tem prioridade sobre o valor deste arquivo.
LOJA_INTEGRADA_PERSONAL_TOKEN=
LOJA_INTEGRADA_ENABLED=true

# Endereco da loja. Nao monta a URL do produto — as URLs da Loja Integrada sao
# baseadas no NOME e editaveis item a item — mas avisa quando o link colado no
# cadastro do produto for de outro dominio.
LI_DOMINIO=

# --- Travas de seguranca ---
# Enquanto false, NADA e escrito nas plataformas externas. Toda funcao que faca
# POST/PUT/DELETE chama uma guarda antes de enviar.
ML_PUBLICACAO=false
BLING_ESCRITA=false
LI_ESCRITA=false
# Lista de SKUs liberados para escrita na Loja Integrada, separados por virgula.
# Vazia libera todos (com LI_ESCRITA=true).
LI_ESCRITA_CODIGOS=

# --- IA (Anthropic) ---
# Titulo e descricao de produto em "Referencias de mercado". Crie a chave em
# console.anthropic.com. Depois de preencher, reinicie o servidor.
ANTHROPIC_API_KEY=

# --- Imagens (Photoroom) ---
# Tratamento da foto do produto novo (iluminacao, melhoria, ampliacao). Crie a chave
# em app.photoroom.com/api-dashboard, no plano Plus (Image Editing API).
# Para TESTAR, use a chave de SANDBOX, a que ja comeca com "sandbox_": e gratuita
# (ate 1000 por mes, 100 por dia) e sai com marca d'agua. Cole INTEIRA, sem
# acrescentar outro prefixo. Para producao, troque pela chave de producao (sk_pr_...),
# que COBRA por imagem. Depois de mudar, reinicie o servidor.
PHOTOROOM_API_KEY=

# Chave de PRODUCAO: e a que COBRA (US$ 0,10 por imagem) e devolve a foto SEM marca
# d'agua. So e usada no botao "Comprar" da previa, e mesmo com a chave colada o
# sistema NAO compra enquanto PHOTOROOM_COMPRA nao for true (trava, no molde de
# ML_PUBLICACAO e BLING_ESCRITA). Enquanto estivermos TESTANDO, deixe false.
PHOTOROOM_API_KEY_PRODUCAO=
PHOTOROOM_COMPRA=false

# --- Imagens (Nano Banana, Google) ---
# Foto de estudio refeita pelo Nano Banana na janela "Fotos do produto". Crie a chave em
# aistudio.google.com ("Get API key" > "Create API key") e ATIVE O FATURAMENTO (Plan / Billing):
# o Google nao tem camada gratuita nem sandbox para imagem, e cada geracao COBRA (de US$ 0,034 a
# US$ 0,134, conforme o modelo). Depois de mudar, reinicie o servidor.
GEMINI_API_KEY=
# Trava, no molde de PHOTOROOM_COMPRA: mesmo com a chave colada, nada e gerado enquanto for false.
NANO_BANANA_GERACAO=false
# Teto de geracoes por dia (as que deram certo). Passou dele, o botao Gerar avisa e para.
NANO_BANANA_TETO_DIA=50

# --- Santana (portal de fornecedor, preco so com login) ---
# So para os scripts de investigacao (teste-login-santana.js e
# teste-categoria-santana.js). A COLETA NAO USA: o login da fonte fica cifrado na
# propria FonteColeta, informado na tela. Estas linhas saem quando os scripts nao
# forem mais usados.
SANTANA_USUARIO=
SANTANA_SENHA=

# --- Copia de desenvolvimento e backup externo (migracao para a VPS) ---
# Remoto do rclone onde a VPS guarda os backups (Cloudflare R2). O `npm run copia:atualizar` baixa dali o dump
# mais novo; vazio, so funciona com --dump=<arquivo>. Ex.: r2:rise-backup
RCLONE_REMOTO=

# Token gratuito da AwesomeAPI (dolar em tempo real). Opcional: sem ele, o "Dolar agora" usa o boletim do Banco Central.
AWESOMEAPI_TOKEN=
